# as-registrar 环境变量（拷到 /etc/as-registrar/env 后填入真实值）
# 详见 server/as-registrar/README.md

# Tuwunel (homeserver) 连接 —— as-registrar 与 Tuwunel 同机时用 localhost
HOMESERVER_URL=http://127.0.0.1:8008

# admin 账号（在 Tuwunel 上创建）的 access token
#   获取：登录 admin 账号后调 GET /_matrix/client/v3/account/admin → 或用 matrix-js-sdk / element 的"帮助→查看登录会话"
ADMIN_ACCESS_TOKEN=

# admin room 的 roomId（!xxx:server，把 admin 账号拉进去）
#   Tuwunel 的 !admin 命令在该账号的 admin room 内生效
ADMIN_ROOM_ID=

# as-registrar 自身的 HTTP Bearer 令牌（Jarvis 客户端用 REGISTRAR_TOKEN 连它）
#   生成：openssl rand -hex 32
AS_REGISTRAR_TOKEN=

# Jarvis 首次绑定时须出示的令牌（可选；留空=不校验，生产建议设置）
#   生成：openssl rand -hex 32
REGISTRATION_TOKEN=

# 监听端口/地址（生产走反代时保持 127.0.0.1，由 nginx 暴露成 https）
PORT=8797
BIND_HOST=127.0.0.1
